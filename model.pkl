from sklearn.ensemble import RandomForestClassifier
import pickle

# Dummy training data
X = [
    [1,1,0,0,0],  # fever + cough
    [0,0,1,0,0],  # chest pain
    [0,0,0,1,0],  # fatigue
    [0,0,0,0,1],  # old age
]
y = ["HIGH","HIGH","MEDIUM","LOW"]

model = RandomForestClassifier()
model.fit(X, y)

pickle.dump(model, open("model.pkl","wb"))
